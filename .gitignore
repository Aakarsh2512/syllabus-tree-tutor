# Course material and generated index are never committed
data/raw/*
!data/raw/.gitkeep
data/index/*
!data/index/.gitkeep

# Uploaded corpora: someone else's PDFs and their indexes
data/corpora/
data/index_backup*/

# Python
.venv/
__pycache__/
*.pyc
.env

# Node
node_modules/
frontend/dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
