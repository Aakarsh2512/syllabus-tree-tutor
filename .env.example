# Copy this file to .env and edit. Every value here has a working default,
# so the project runs with no configuration at all.

# Which LLM writes the tree summaries and the answers.
#   offline   - no LLM at all. Extractive summaries and extractive answers.
#               Always available, costs nothing, needs no setup.
#   ollama    - a local model on your machine. Free. Install from ollama.com,
#               then: ollama pull llama3.2:3b
#   anthropic - Claude API. Needs ANTHROPIC_API_KEY.
#   openai    - OpenAI API. Needs OPENAI_API_KEY.
LLM_PROVIDER=offline

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Hosted providers (used when LLM_PROVIDER=anthropic or openai)
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Indexing knobs
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_CHARS=1200
CHUNK_OVERLAP=150
MAX_TREE_LEVELS=4
